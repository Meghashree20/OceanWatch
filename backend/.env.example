# Development profile. Set OCEANWATCH_ENV before starting the API.
OCEANWATCH_ENV=development

# MongoDB settings (separate database per profile)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=oceanwatch_development
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
DBSCAN_EPS_KM=150
DBSCAN_MIN_SAMPLES=10

# Observed trend comparison (pieces/m3); equal-length adjacent windows.
POLLUTION_RISK_MEDIUM_THRESHOLD=1
POLLUTION_RISK_HIGH_THRESHOLD=10
POLLUTION_RISK_CRITICAL_THRESHOLD=100
POLLUTION_TREND_WINDOW_DAYS=90
POLLUTION_TREND_MIN_OBSERVATIONS=3
POLLUTION_TREND_MIN_RELATIVE_CHANGE=0.25
POLLUTION_TREND_CELL_SIZE_DEGREES=1
POLLUTION_DATA_FRESHNESS_MAX_DAYS=90

# API settings
PROJECT_NAME="OceanWatch API"
API_V1_STR="/api/v1"

# CORS settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]

# Authentication
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=oceanwatch_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# Optional trusted Ed25519 PEM public key for signed satellite provenance.
# Leave unset until a trusted imagery verification process is configured.
SATELLITE_PROVENANCE_PUBLIC_KEY=

# Optional SMTP provider for manually approved organization notifications.
# No organization emails are sent automatically.
SMTP_TEST_MODE=true
SMTP_TEST_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15

# Private, sanitized user-submitted images (never served as static public assets).
PRIVATE_MEDIA_DIR=private_media
PRIVATE_MEDIA_MAX_BYTES=5242880
PRIVATE_MEDIA_MAX_PIXELS=20000000
