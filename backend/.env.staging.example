OCEANWATCH_ENV=staging
MONGODB_URL=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=oceanwatch_staging_replace_this_suffix
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
DBSCAN_EPS_KM=150
DBSCAN_MIN_SAMPLES=10
POLLUTION_RISK_MEDIUM_THRESHOLD=1
POLLUTION_RISK_HIGH_THRESHOLD=10
POLLUTION_RISK_CRITICAL_THRESHOLD=100
POLLUTION_TREND_WINDOW_DAYS=90
POLLUTION_TREND_MIN_OBSERVATIONS=3
POLLUTION_TREND_MIN_RELATIVE_CHANGE=0.25
POLLUTION_TREND_CELL_SIZE_DEGREES=1
POLLUTION_DATA_FRESHNESS_MAX_DAYS=90
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=oceanwatch_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
SATELLITE_MODEL_PATH=models/model.pth
SATELLITE_SAMPLES_DIR=samples
SATELLITE_DEVICE=cpu
SATELLITE_CONFIDENCE_THRESHOLD=0.5
SATELLITE_PROVENANCE_PUBLIC_KEY=
SMTP_TEST_MODE=true
SMTP_TEST_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15
PRIVATE_MEDIA_DIR=/var/lib/oceanwatch/private-media
PRIVATE_MEDIA_MAX_BYTES=5242880
PRIVATE_MEDIA_MAX_PIXELS=20000000
BACKEND_CORS_ORIGINS=["https://staging.example.invalid"]
