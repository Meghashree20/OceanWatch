OCEANWATCH_ENV=test
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=oceanwatch_test
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_CONNECT_TIMEOUT_MS=3000
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=oceanwatch_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
SMTP_TEST_MODE=true
SMTP_TEST_RECIPIENT=oceanwatch-test@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=5
PRIVATE_MEDIA_DIR=test_private_media
PRIVATE_MEDIA_MAX_BYTES=5242880
PRIVATE_MEDIA_MAX_PIXELS=20000000
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
